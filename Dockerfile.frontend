# Build stage
FROM node:20-slim AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Production stage
FROM node:20-slim

WORKDIR /app

# Install 'serve' to run the static site
RUN npm install -g serve

# Copy only the compiled files from the build stage
COPY --from=build /app/dist ./dist

# Railway automatically provides the PORT environment variable
EXPOSE 8080

# At container startup: inject VITE_API_URL into a config.js read by the browser,
# so the env var set in Railway dashboard is picked up at runtime (not just build time).
CMD sh -c "\
  if [ -n \"$VITE_API_URL\" ]; then \
    echo \"window.__RUNTIME_CONFIG__ = { API_URL: \\\"$VITE_API_URL\\\" };\" > /app/dist/config.js; \
  else \
    echo '/* No VITE_API_URL set — using build-time or fallback value */' > /app/dist/config.js; \
  fi && \
  serve -s dist -l tcp://0.0.0.0:${PORT:-8080}"

