# VR Image Sorter — Environment Configuration Template
# Copy this file to .env and adjust as needed.

# Application Environment: 'development' (default for local) or 'production'
# In 'development', a fallback dev secret is used. In 'production', SESSION_SECRET_KEY is required.
APP_ENV=development

# Session secret key for HMAC signature verification.
# In production, set this to at least 16 high-entropy characters.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=vr-sorter-local-secret-change-in-production-32x

# Server Ports
PORT=8001
UI_PORT=8088

# OCR Engine Concurrency Tuning
# 0 or unset means auto-calculated (0.6x CPU cores, min 2, max 8)
OCR_POOL_SIZE=0
BATCH_CONCURRENCY=0
OCR_THREADS_PER_ENGINE=1

# Accuracy & Quality Thresholds
OCR_MIN_CONFIDENCE=0.88
OCR_EARLY_EXIT_CONFIDENCE=0.95
ENABLE_BARCODE_SCANNER=True

# Session TTL (in seconds, default 48h for local workflow)
SESSION_TTL_SECONDS=172800
