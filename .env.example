# =============================================================================
# VR Saree Sorter — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your deployment.
# All variables have safe defaults; only override what you need to change.
# =============================================================================

# -----------------------------------------------------------------------------
# OCR & Processing Configuration
# -----------------------------------------------------------------------------

# Number of RapidOCR engine instances in the pool (CPU-bound).
# Recommended: number of CPU cores / 2.  Range: 1–8.
OCR_POOL_SIZE=2

# Maximum images processed concurrently across the whole worker (I/O-bound).
# Must be >= OCR_POOL_SIZE.  Recommended: OCR_POOL_SIZE * 4.  Range: 1–32.
BATCH_CONCURRENCY=8

# Maximum files accepted in a single /api/process request.  Range: 1–5000.
MAX_BATCH_SIZE=1000

# Per-image processing timeout in seconds.  Range: 30–300.
WORKER_TIMEOUT=120

# -----------------------------------------------------------------------------
# Session Management
# -----------------------------------------------------------------------------

# Seconds before an idle session is expired and its temp files deleted.
# Range: 300–86400 (5 minutes to 24 hours).
SESSION_TTL=3600

# How often (seconds) the background cleanup task scans for expired sessions.
# Range: 60–3600 (1 minute to 1 hour).
SESSION_CLEANUP_INTERVAL=300

# Hard cap on simultaneous live sessions.  Range: 10–10000.
MAX_CONCURRENT_SESSIONS=1000

# -----------------------------------------------------------------------------
# Resource Limits
# -----------------------------------------------------------------------------

# Memory usage % at which warnings are emitted.  Range: 50–95.
MAX_MEMORY_PERCENT=80

# Maximum size of a single uploaded image file.
MAX_FILE_SIZE=25MB

# Maximum combined size of all files in one upload batch.
MAX_TOTAL_SIZE=200MB

# Maximum pixel width or height of an uploaded image (DecompressionBomb guard).
MAX_IMAGE_DIMENSION=8000

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable/disable the zxing-cpp barcode scanning stage.
ENABLE_BARCODE_SCANNER=true

# Reuse numpy/image buffers where possible to reduce GC pressure.
ENABLE_MEMORY_POOLING=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Directory where rotating log files are written.
# LOG_DIR=logs

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# HTTP port uvicorn listens on.
PORT=8080

# Comma-separated list of allowed CORS origins.
# ALLOWED_ORIGINS=https://your-frontend.railway.app,http://localhost:5173
